{
  "name": "portfolio-site",
  "version": "2.0.0",
  "description": "Ryo.S portfolio site (pre-built with esbuild)",
  "main": "index.js",
  "scripts": {
    "bundle": "esbuild src/app.jsx --bundle --minify --jsx=automatic --define:process.env.NODE_ENV=\"'production'\" --outfile=dist/assets/js/bundle.js",
    "build": "rm -rf dist && mkdir -p dist && cp -r index.html assets uploads _headers dist/ && npm run bundle",
    "watch": "esbuild src/app.jsx --bundle --jsx=automatic --outfile=assets/js/bundle.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "private": true
}